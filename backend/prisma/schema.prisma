datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id           Int          @id @default(autoincrement())
  nama         String
  email        String       @unique
  password     String
  noHp         String?
  alamat       String?
  fotoProfil   String?      // Path/URL foto profil yang diupload
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  pengumuman   Pengumuman[]
}

model Santri {
  id           Int          @id @default(autoincrement())
  nama         String
  email        String?      @unique
  password     String?
  noHp         String?
  alamat       String?
  namaWali     String?
  kelas        String?      // Hanya untuk santri, misal "Kelas 10-A", "Kelas 11-B"
  status       String       @default("ACTIVE") // "ACTIVE" atau "INACTIVE"
  fotoProfil   String?      // Path/URL foto profil yang diupload
  isBeasiswa   Boolean      @default(false)
  tanggalMasuk DateTime?    // Tanggal resmi masuk/daftar pesantren
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  nilai        Nilai[]
  sanksi       Sanksi[]
  pembayaran   Pembayaran[]
}

model Nilai {
  id            Int      @id @default(autoincrement())
  santriId      Int
  santri        Santri   @relation(fields: [santriId], references: [id], onDelete: Cascade)
  mataPelajaran String
  nilaiUts      Float?   // Nullable — bisa diisi UTS saja atau UAS saja
  nilaiUas      Float?   // Nullable — bisa diisi UTS saja atau UAS saja
  semester      String   // "GANJIL" or "GENAP"
  tahunAjaran   String   // misal "2025/2026"
  tanggalInput  DateTime @default(now())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Sanksi {
  id                 Int      @id @default(autoincrement())
  santriId           Int
  santri             Santri   @relation(fields: [santriId], references: [id], onDelete: Cascade)
  tanggalPelanggaran DateTime
  tahun              String   // misal "2025/2026"
  deskripsi          String
  kategori           String   // "RINGAN", "SEDANG", "BERAT"
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model Pembayaran {
  id           Int       @id @default(autoincrement())
  santriId     Int
  santri       Santri    @relation(fields: [santriId], references: [id], onDelete: Cascade)
  bulan        Int       // 1 - 12 (Jan - Des)
  tahun        Int       // misal 2026
  status       String    // "LUNAS" or "BELUM_BAYAR"
  tanggalBayar DateTime?
  jumlah       Float
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@unique([santriId, bulan, tahun])
}

model Pengumuman {
  id        Int      @id @default(autoincrement())
  judul     String
  isi       String
  authorId  Int
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Notification {
  id        Int      @id @default(autoincrement())
  judul     String
  isi       String
  kategori  String   // "UJIAN", "SPP", "KEAMANAN", "UMUM"
  santriId  Int?     // ID Santri penerima (null = semua santri / global)
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
}

model Pendaftaran {
  id              Int       @id @default(autoincrement())
  nama            String
  email           String    @unique
  password        String
  noHp            String?
  role            String    @default("SANTRI") // "SANTRI", "WALI_SANTRI", "USTADZ", "ADMIN"
  nis             String?   // Nomor Induk Santri (verifikasi opsional)
  namaWali        String?   // Nama Wali (verifikasi opsional)
  status          String    @default("PENDING") // "PENDING", "APPROVED", "REJECTED"
  alasanPenolakan String?
  matchedSantriId Int?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

